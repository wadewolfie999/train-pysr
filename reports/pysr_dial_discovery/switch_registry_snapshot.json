{
  "classification_schema": {
    "availability": [
      "supported",
      "deferred"
    ],
    "rule": "Every switch has one availability classification and one safety classification. Unsafe and deferred switches are blocked by config validation. Physics-review switches require an explicit acknowledgement.",
    "safety": [
      "safe",
      "unsafe",
      "requires_physics_review",
      "deferred"
    ]
  },
  "environment": {
    "julia": "1.12.6",
    "pysr": "1.5.10",
    "symbolic_regression": "1.11.3"
  },
  "execution": {
    "binary_operator_presets": {
      "additive": {
        "availability": "supported",
        "default": false,
        "operators": [
          "+",
          "-"
        ],
        "safety": "safe"
      },
      "polynomial": {
        "availability": "supported",
        "default": true,
        "operators": [
          "+",
          "-",
          "*"
        ],
        "safety": "safe"
      },
      "power": {
        "availability": "supported",
        "default": false,
        "operators": [
          "+",
          "-",
          "*",
          "^"
        ],
        "risk": "General powers can leave the real finite domain.",
        "safety": "unsafe"
      },
      "rational": {
        "availability": "supported",
        "default": false,
        "operators": [
          "+",
          "-",
          "*",
          "/"
        ],
        "risk": "Evolved denominators can be zero or numerically small.",
        "safety": "requires_physics_review"
      }
    },
    "budget_dials": {
      "niterations": {
        "availability": "supported",
        "default": 100,
        "minimum": 1,
        "safety": "safe"
      },
      "population_size": {
        "availability": "supported",
        "default": 27,
        "minimum": 2,
        "safety": "safe"
      },
      "populations": {
        "availability": "supported",
        "default": 20,
        "minimum": 1,
        "safety": "safe"
      },
      "timeout_in_seconds": {
        "availability": "supported",
        "default": 7200,
        "minimum": 1,
        "safety": "safe"
      }
    },
    "complexity_dials": {
      "complexity_of_operators": {
        "availability": "supported",
        "default": null,
        "safety": "requires_physics_review"
      },
      "constraints": {
        "availability": "supported",
        "default": null,
        "safety": "requires_physics_review"
      },
      "maxdepth": {
        "availability": "supported",
        "default": null,
        "minimum": 1,
        "safety": "safe"
      },
      "maxsize": {
        "availability": "supported",
        "default": 40,
        "minimum": 2,
        "safety": "safe"
      },
      "nested_constraints": {
        "availability": "supported",
        "default": null,
        "safety": "requires_physics_review"
      },
      "parsimony": {
        "availability": "supported",
        "default": 0.0,
        "minimum": 0.0,
        "safety": "safe"
      }
    },
    "custom_operator_presets": {
      "guarded_division": {
        "availability": "supported",
        "binary_definitions": [
          "guarded_div(x, y) = x / (abs(y) + 1.0e-12)"
        ],
        "default": false,
        "risk": "The fixed epsilon has unresolved dimensional meaning.",
        "safety": "requires_physics_review",
        "sympy_mappings": [
          "guarded_div"
        ],
        "unary_definitions": []
      },
      "none": {
        "availability": "supported",
        "binary_definitions": [],
        "default": true,
        "safety": "safe",
        "unary_definitions": []
      },
      "square": {
        "availability": "supported",
        "binary_definitions": [],
        "default": false,
        "safety": "safe",
        "sympy_mappings": [
          "square"
        ],
        "unary_definitions": [
          "square(x) = x * x"
        ]
      }
    },
    "deterministic": {
      "false": {
        "availability": "supported",
        "default": false,
        "safety": "safe"
      },
      "true": {
        "availability": "supported",
        "default": true,
        "requires_parallelism": "serial",
        "safety": "safe"
      }
    },
    "loss_presets": {
      "binary_cross_entropy": {
        "availability": "deferred",
        "default": false,
        "reason": "A reviewed score-to-probability link and stable loss definition are not available.",
        "safety": "requires_physics_review"
      },
      "direct_auc": {
        "availability": "deferred",
        "default": false,
        "reason": "ROC-AUC is not an elementwise PySR loss in the current workflow.",
        "safety": "deferred"
      },
      "unweighted_absolute_error": {
        "availability": "supported",
        "default": false,
        "elementwise_loss": "loss(prediction, target) = abs(prediction - target)",
        "requires_sample_weights": false,
        "safety": "safe"
      },
      "unweighted_squared_error": {
        "availability": "supported",
        "default": false,
        "elementwise_loss": "loss(prediction, target) = (prediction - target)^2",
        "requires_sample_weights": false,
        "safety": "safe"
      },
      "weighted_absolute_error": {
        "availability": "supported",
        "default": false,
        "elementwise_loss": "loss(prediction, target, weight) = weight * abs(prediction - target)",
        "requires_sample_weights": true,
        "safety": "safe"
      },
      "weighted_squared_error": {
        "availability": "supported",
        "default": true,
        "elementwise_loss": "loss(prediction, target, weight) = weight * (prediction - target)^2",
        "requires_sample_weights": true,
        "safety": "safe"
      }
    },
    "model_selection": {
      "accuracy": {
        "availability": "supported",
        "default": false,
        "safety": "safe"
      },
      "best": {
        "availability": "supported",
        "default": true,
        "safety": "safe"
      },
      "score": {
        "availability": "supported",
        "default": false,
        "safety": "safe"
      }
    },
    "output_policy_presets": {
      "cleaned_run_local": {
        "availability": "supported",
        "default": false,
        "description": "Keep final run artifacts but allow PySR to delete run-local temporary files.",
        "safety": "safe",
        "settings": {
          "allow_overwrite": false,
          "delete_tempfiles": true,
          "temp_equation_file": false,
          "temp_subdir": "pysr_temp",
          "workspace_subdir": "pysr_workspace"
        }
      },
      "external_temp": {
        "availability": "deferred",
        "default": false,
        "reason": "External temporary paths would weaken the repo-local evidence boundary.",
        "safety": "deferred"
      },
      "overwrite_existing": {
        "availability": "supported",
        "default": false,
        "reason": "Existing run evidence must never be overwritten.",
        "safety": "unsafe"
      },
      "preserved_run_local": {
        "availability": "supported",
        "default": true,
        "description": "Preserve run-local workspace and temporary files for review.",
        "safety": "safe",
        "settings": {
          "allow_overwrite": false,
          "delete_tempfiles": false,
          "temp_equation_file": false,
          "temp_subdir": "pysr_temp",
          "workspace_subdir": "pysr_workspace"
        }
      }
    },
    "parallelism": {
      "multiprocessing": {
        "availability": "supported",
        "default": false,
        "reason": "Process lifecycle and artifact isolation need a separately authorized live test.",
        "safety": "deferred"
      },
      "multithreading": {
        "availability": "supported",
        "default": false,
        "reason": "Scheduling and determinism cannot be validated without a separately authorized live fit.",
        "safety": "deferred"
      },
      "serial": {
        "availability": "supported",
        "default": true,
        "safety": "safe"
      }
    },
    "precision": {
      "16": {
        "availability": "supported",
        "default": false,
        "risk": "Reduced dynamic range is unsuitable for the first baseline.",
        "safety": "unsafe"
      },
      "32": {
        "availability": "supported",
        "default": true,
        "safety": "safe"
      },
      "64": {
        "availability": "supported",
        "default": false,
        "safety": "safe"
      }
    },
    "runtime_threads": {
      "availability": "supported",
      "default": 1,
      "environment_variables": [
        "JULIA_NUM_THREADS",
        "PYTHON_JULIACALL_THREADS"
      ],
      "minimum": 1,
      "safety": "safe"
    },
    "sample_weight_presets": {
      "balanced": {
        "availability": "supported",
        "default": true,
        "implementation": "sklearn.utils.class_weight.compute_sample_weight",
        "safety": "safe"
      },
      "manual_class_weights": {
        "availability": "supported",
        "default": false,
        "safety": "requires_physics_review"
      },
      "none": {
        "availability": "supported",
        "default": false,
        "safety": "safe"
      }
    },
    "unary_operator_presets": {
      "exp_only": {
        "availability": "supported",
        "default": false,
        "operators": [
          "exp"
        ],
        "safety": "unsafe"
      },
      "log_only": {
        "availability": "supported",
        "default": false,
        "operators": [
          "log"
        ],
        "safety": "requires_physics_review"
      },
      "none": {
        "availability": "supported",
        "default": true,
        "operators": [],
        "safety": "safe"
      },
      "periodic_candidates": {
        "availability": "supported",
        "default": false,
        "operators": [
          "sin",
          "cos"
        ],
        "risk": "Periodicity has no reviewed physical interpretation for these features.",
        "safety": "requires_physics_review"
      },
      "singular_high_risk_candidates": {
        "availability": "supported",
        "default": false,
        "operators": [
          "inv",
          "sqrt",
          "tan",
          "coth"
        ],
        "risk": "Contains singularities or restricted real domains.",
        "safety": "unsafe"
      },
      "tanh_only": {
        "availability": "supported",
        "default": false,
        "operators": [
          "tanh"
        ],
        "safety": "safe"
      },
      "transcendental_candidates": {
        "availability": "supported",
        "default": false,
        "operators": [
          "log",
          "exp",
          "tanh"
        ],
        "risk": "log has a restricted domain and exp overflows on the observed raw mass range.",
        "safety": "unsafe"
      }
    },
    "warm_start": {
      "false": {
        "availability": "supported",
        "default": true,
        "safety": "safe"
      },
      "true": {
        "availability": "supported",
        "default": false,
        "risk": "A fresh baseline must not inherit a prior search state.",
        "safety": "unsafe"
      }
    }
  },
  "preprocessing": {
    "feature_sets": {
      "base": {
        "availability": "supported",
        "columns": [
          "mchi1",
          "mchipm1"
        ],
        "default": true,
        "safety": "safe"
      },
      "base_plus_gap": {
        "availability": "supported",
        "columns": [
          "mchi1",
          "mchipm1",
          "mass_gap"
        ],
        "default": false,
        "formulas": {
          "mass_gap": "mchipm1 - mchi1"
        },
        "safety": "requires_physics_review"
      },
      "base_plus_ratio": {
        "availability": "supported",
        "columns": [
          "mchi1",
          "mchipm1",
          "mass_ratio"
        ],
        "default": false,
        "formulas": {
          "mass_ratio": "mchipm1 / mchi1"
        },
        "safety": "requires_physics_review"
      },
      "gap_only": {
        "availability": "supported",
        "columns": [
          "mass_gap"
        ],
        "default": false,
        "formulas": {
          "mass_gap": "mchipm1 - mchi1"
        },
        "safety": "requires_physics_review"
      },
      "gap_plus_ratio": {
        "availability": "supported",
        "columns": [
          "mass_gap",
          "mass_ratio"
        ],
        "default": false,
        "formulas": {
          "mass_gap": "mchipm1 - mchi1",
          "mass_ratio": "mchipm1 / mchi1"
        },
        "safety": "requires_physics_review"
      },
      "ratio_only": {
        "availability": "supported",
        "columns": [
          "mass_ratio"
        ],
        "default": false,
        "formulas": {
          "mass_ratio": "mchipm1 / mchi1"
        },
        "safety": "requires_physics_review"
      }
    },
    "modes": {
      "dimensionless_reference": {
        "availability": "supported",
        "default": false,
        "description": "Divide every feature by a positive, explicitly recorded reference scale.",
        "fit_scope": "explicit_reference_scales",
        "safety": "requires_physics_review"
      },
      "log1p": {
        "availability": "supported",
        "default": false,
        "description": "Apply natural log(1 + x) after requiring non-negative inputs.",
        "fit_scope": "domain_check_only",
        "safety": "requires_physics_review"
      },
      "log_reference": {
        "availability": "supported",
        "default": false,
        "description": "Apply natural log(x/reference) after requiring positive inputs and scales.",
        "fit_scope": "explicit_reference_scales",
        "safety": "requires_physics_review"
      },
      "raw": {
        "availability": "supported",
        "default": true,
        "description": "Preserve input values exactly.",
        "fit_scope": "none",
        "safety": "safe"
      },
      "robust": {
        "availability": "supported",
        "default": false,
        "description": "Subtract the training median and divide by the training interquartile range.",
        "fit_scope": "training_rows_only",
        "safety": "safe"
      },
      "standard": {
        "availability": "supported",
        "default": false,
        "description": "Subtract the training mean and divide by the training population standard deviation.",
        "fit_scope": "training_rows_only",
        "safety": "safe"
      }
    }
  },
  "recommended_baseline": {
    "binary_operator_preset": "polynomial",
    "custom_operator_preset": "none",
    "deterministic": true,
    "feature_set": "base",
    "loss_preset": "weighted_squared_error",
    "maxdepth": null,
    "maxsize": 40,
    "model_selection": "best",
    "niterations": 100,
    "output_policy_preset": "preserved_run_local",
    "parallelism": "serial",
    "parsimony": 0.0,
    "population_size": 27,
    "populations": 20,
    "precision": 32,
    "preprocessing_mode": "raw",
    "runtime_threads": 1,
    "sample_weight_preset": "balanced",
    "timeout_in_seconds": 7200,
    "unary_operator_preset": "none",
    "warm_start": false
  },
  "registry_id": "pysr_switch_registry_v1",
  "schema_version": 1,
  "status": "provisional_unverified_pending_review"
}
